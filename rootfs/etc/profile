# /etc/profile - NeonBitOS shell configuration

# Set terminal type
export TERM=linux

# Set custom prompt with colors
export PS1="\[\e[36m\]neon\[\e[35m\]@\[\e[36m\]bit\[\e[0m\]:\[\e[33m\]\w\[\e[0m\]# "

# Set PATH
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# Aliases
alias ls='ls --color=auto'
alias ll='ls -lah'
alias ..='cd ..'

# Welcome message (only on login)
if [ "$SHLVL" = "1" ]; then
    clear
    echo ""
    echo -e "\e[35m          ╔═════════════╗\e[0m"
    echo -e "\e[35m          ║  \e[36m╔═══╗ ╔═╗\e[35m  ║\e[0m"
    echo -e "\e[35m          ║  \e[36m║ █ ║ ║█║\e[35m  ║\e[0m"
    echo -e "\e[35m          ║  \e[36m╚═╦═╝ ╚═╝\e[35m  ║\e[0m"
    echo -e "\e[35m          ║    \e[36m║\e[35m        ║\e[0m"
    echo -e "\e[35m          ╚════\e[36m╩\e[35m════════╝\e[0m"
    echo -e "\e[33m            ∿ ∿ ∿ ∿ ∿\e[0m"
    echo -e "\e[36m         N E O N B I T O S\e[0m"
    echo -e "\e[35m      Minimal Linux from Scratch\e[0m"
    echo ""
fi
